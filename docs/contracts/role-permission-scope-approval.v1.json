    "assignment",
    "partnerGrant",
    "fieldPolicy",
    "expiresAt",
    "expectedVersion"
  ],
  "invariants": [
    "Platform super admin has no implicit customer business-data read or PostgreSQL RLS bypass",
    "Tenant admin cannot assign nondelegable permissions, owners, or platform roles and cannot self-escalate",
    "Last active owner cannot be removed without verified and accepted replacement",
    "Quote exception creator and exception approver are different principals for same request",
    "Customer quote acceptance does not confirm resource reservation or booking",
    "Carrier partner sees permitted buy-side terms and shipment scope, never forwarder sell price or margin",
    "All denial/default routes are audited where security critical",
    "Permissions are checked at execution time including jobs and downloads; revoke must terminate future authorized access",
    "Quote issued version is immutable; material revision is a new version",
    "No business write is allowed across module-owned persistence through a shared mapper",
    "External customer identity is not a membership of provider tenant and cannot delegate staff/owner permissions",
    "Customer access is explicitly scoped to provider tenant + customer relationship + exact RFQ/order/shipment/document and verified permissions",
    "Tenant inbound RFQ queue is provider-owned while My Orders is customer-relationship filtered; no cross-customer list access",
    "Customer tracking exposes only freshness-aware permission-filtered milestones/ETA and permitted evidence, never foreign GPS history or carrier purchase price",
    "Review requires service completion evidence, verified reviewer relationship, dedup per eligible service and audit; public reputation publication is a separate later policy",
    "Review eligibility derives from source-owned completion evidence/event and never from a stale UI status alone"
  ],
  "policyNotes": {
    "PLATFORM_ONBOARDING_CASE": "Verified onboarding request; control-plane identity separate from tenant business DB; audited idempotent create.",
    "PENDING_TENANT_AND_VERIFIED_INVITEE": "Only on pending onboarding or separately authorized recovery; invitation tied to verified identity and expiring token.",
    "DELEGATED_ROLE_SET_AND_MEMBER_SCOPE": "Delegated permission ceilings intersect tenant/legal-entity/branch and prohibitions on modifying own role; changing branch cannot expand grant.",
    "OWN_SHIPPER_TENANT_OR_EXPLICIT_SUBMISSION_GRANT": "Shipper creates own RFQ or sends explicit request through approved B2B scope; acceptance occurs only by authorized shipper legal entity.",
    "EXACT_QUOTE_VERSION_FOR_AUTHORIZED_SHIPPER": "Customer grant is restricted to quote version and permitted customer-facing fields; foreign supplier buy-rate is hidden.",
    "ASSIGNED_CUSTOMER_IN_FORWARDER_TENANT": "Assignment/legal entity must be authorized; no cross-tenant read by passing foreign ID.",
    "AUTHORIZED_FORWARDER_PROCUREMENT_SCOPE": "Carrier selection is an operational choice, not confirmation of CapacityReservation/Booking.",
    "EXTERNAL_CUSTOMER_PORTAL": "External portal identity with scoped customer-service relationship to provider tenant, not an internal tenant administrator or employee membership.",
    "CUSTOMER_ACCOUNT_PROVIDER_TENANT_ALLOWED_ORDER_SET": "The provider owns order data; customer sees only authorized customer-side projection and exact eligible orders; mapping and RLS must enforce relationship.",
    "COMPLETED_ELIGIBLE_SERVICE_FOR_CUSTOMER_ORDER": "Delivery/POD verified by execution source; commercial feedback eligibility derived from trusted event with dedup and replay protection."
  },
