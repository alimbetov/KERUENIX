{
  "schemaVersion": "1.0",
  "status": "PROPOSED_NOT_ENFORCED_IN_CODE",
  "date": "2026-11-07",
  "architecture": "Spring Modulith logical modules / single deployable business core",
  "source": "docs/13-modular-architecture-options-v1.md",
  "rules": [
    "NO_CROSS_MODULE_INTERNAL_IMPORT",
    "NO_CROSS_MODULE_REPOSITORY_OR_DIRECT_DB_WRITE",
    "PUBLIC_API_AND_VERSIONED_EVENT_ONLY",
    "TENANT_AUTH_REQUIRED_EVERY_COMMAND",
    "NO_CYCLES",
    "EXTERNAL_EVENTS_REQUIRES_DURABLE_DELIVERY"
  ],
  "modules": [
    {
      "id": "tenancy",
      "phase": "R0",
      "allowedDirectDependencies": [],
      "owns": [
        "Tenant",
        "LegalEntity",
        "Membership",
        "PartnerGrant"
      ],
      "publicContracts": [
        "AccessPolicyApi",
        "TenantLookupApi"
      ]
    },
    {
      "id": "commercial",
      "phase": "R0",
      "allowedDirectDependencies": [
        "tenancy"
      ],
      "owns": [
        "RFQ",
        "QuoteVersion",
        "CarrierOffer"
      ],
      "publicContracts": [
        "CommercialApi",
        "QuoteAccepted"
      ]
    },
    {
      "id": "fleet",
      "phase": "R0",
      "allowedDirectDependencies": [
        "tenancy"
      ],
      "owns": [
        "VehicleCombination",
        "Equipment",
        "CapacityHold"
      ],
      "publicContracts": [
        "FleetCapacityApi",
        "CapacityConfirmed"
      ]
    },
    {
      "id": "cargo",
      "phase": "R0",
      "allowedDirectDependencies": [
        "tenancy"
      ],
      "owns": [
        "CargoProfile",
        "HandlingUnit",
        "CargoClassification"
      ],
      "publicContracts": [
