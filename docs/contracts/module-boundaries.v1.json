      "phase": "R0",
      "allowedDirectDependencies": [
        "tenancy"
      ],
      "owns": [
        "ComplianceAssessment",
        "RuleSetActivation"
      ],
      "publicContracts": [
        "ComplianceApi",
        "ComplianceDenied"
      ]
    },
    {
      "id": "booking",
      "phase": "R0",
      "allowedDirectDependencies": [
        "tenancy",
        "commercial",
        "fleet",
        "cargo",
        "compliance"
      ],
      "owns": [
        "Booking",
        "ReservationOrchestration"
      ],
      "publicContracts": [
        "BookingApi",
        "BookingConfirmed"
      ]
    },
    {
      "id": "execution",
      "phase": "R0",
